ALTER TABLE Dim_Patients ADD COLUMN age_group VARCHAR(20);

UPDATE Dim_Patients 
SET age_group = CASE 
    WHEN patient_age &lt; 18 THEN 'Pediatric (&lt;18)'
    WHEN patient_age BETWEEN 18 AND 44 THEN 'Adult (18-44)'
    WHEN patient_age BETWEEN 45 AND 64 THEN 'Middle Aged (45-64)'
    WHEN patient_age &gt;= 65 THEN 'Elderly (65+)'
    ELSE 'Unknown'
END;</sql><current_tab id="0"/></tab_sql></sqlb_project>
